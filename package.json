{
  "name": "adventure-drafter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:architecture && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "format": "prettier --write src tests *.ts *.json *.jsonc *.md",
    "format:check": "prettier --check src tests *.ts *.json *.jsonc *.md",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/almendra": "^5.3.0",
    "@fontsource/cardo": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fondamento": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@fontsource/vollkorn": "^5.3.0",
    "@tiptap/extension-highlight": "^3.7.0",
    "@tiptap/extension-image": "^3.7.0",
    "@tiptap/extension-subscript": "^3.7.0",
    "@tiptap/extension-superscript": "^3.7.0",
    "@tiptap/extension-table": "^3.7.0",
    "@tiptap/extension-text-align": "^3.7.0",
    "@tiptap/extension-text-style": "^3.7.0",
    "@tiptap/extension-typography": "^3.7.0",
    "@tiptap/extension-underline": "^3.7.0",
    "@tiptap/react": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "docx": "^9.5.1",
    "dompurify": "^3.2.7",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "marked": "^16.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
